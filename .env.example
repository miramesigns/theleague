MFL_LEAGUE_ID=35743
MFL_YEAR=2026
MFL_HOST=www42.myfantasyleague.com
MFL_USER_AGENT=PlugGrokBot
MFL_PRIMARY_FRANCHISE_ID=0004

# Server-side MFL login for background push polling (cron / GitHub Actions).
# Never commit real credentials. Password is never logged.
MFL_USERNAME=
MFL_PASSWORD=

# Web Push VAPID keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Required for /api/push/poll (Vercel Pro cron + optional GH Actions backup). Authorization: Bearer …
CRON_SECRET=

# Optional: lookback window (seconds) for timestamped MFL events (default 7200)
# PUSH_POLL_LOOKBACK_SECONDS=7200

# Durable push subscription store (prefer Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Or Supabase (service role). Create tables push_subscriptions + push_sent_notifications
# (see README). SUPABASE_URL may also be provided as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
